# Development defaults - do not commit secrets here
APP_NAME=Groundwork
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Database (async for FastAPI)
DATABASE_URL=postgresql+asyncpg://groundwork:groundwork@db:5432/groundwork

# Database (sync for Celery)
DATABASE_URL_SYNC=postgresql+psycopg2://groundwork:groundwork@db:5432/groundwork

# Test database
TEST_DATABASE_URL=postgresql+asyncpg://groundwork:groundwork@db-test:5432/groundwork_test

# Auth0 (fill in for Phase 2)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ISSUER=

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
