# Development defaults - do not commit secrets here
APP_NAME=Groundwork
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Database (async for FastAPI)
DATABASE_URL=postgresql+asyncpg://groundwork:groundwork@db:5432/groundwork

# Test database
TEST_DATABASE_URL=postgresql+asyncpg://groundwork:groundwork@db-test:5432/groundwork_test

# Auth / OIDC (ADR-010). Dev + test point at the containerized Keycloak
# realm. Production overrides AUTH0_ISSUER / AUTH0_AUDIENCE to point at a
# real cloud IdP (e.g. Auth0). AUTH_STUB_ENABLED is False everywhere now
# the auth middleware is wired up (TASK-014).
AUTH_STUB_ENABLED=false
OIDC_DOMAIN=
OIDC_ISSUER=http://keycloak-test:8080/realms/groundwork-test
OIDC_AUDIENCE=https://api.groundwork.test/

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
